# Environment Variables Example
# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO GIT
# ============================================================

# ---- Supabase / PostgreSQL ----
SUPABASE_DB_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-supabase-db-password>
SUPABASE_DB_MAX_POOL_SIZE=20

# ---- Application ----
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
APP_PROFILE=local

# ---- JWT Configuration ----
JWT_SECRET=<256-bit-minimum-random-secret-base64-encoded>
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_HOURS=24

# ---- Encryption Keys (Election Public Key stored in DB per election) ----
TALLY_KEY_SHARE_DIRECTORY=/opt/evoting/keyshares
TALLY_KEY_SHARE_HOLDER=ELECTION_AUTHORITY

# ---- Hyperledger Fabric ----
FABRIC_GATEWAY_ENDPOINT=localhost:7051
FABRIC_MSP_ID=Org2MSP
FABRIC_CERT_PATH=/opt/fabric/crypto-config/peerOrganizations/org2.evoting.com/users/Admin@org2.evoting.com/msp/signcerts/cert.pem
FABRIC_KEY_PATH=/opt/fabric/crypto-config/peerOrganizations/org2.evoting.com/users/Admin@org2.evoting.com/msp/keystore/
FABRIC_CHANNEL=election-channel
FABRIC_CHAINCODE=evoting-contract
FABRIC_TLS_CERT_PATH=/opt/fabric/crypto-config/peerOrganizations/org2.evoting.com/tlsca/tlsca.org2.evoting.com-cert.pem

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_BALLOT_REQUESTS=1
RATE_LIMIT_BALLOT_WINDOW_MINUTES=60

# ---- Batch Configuration ----
MERKLE_BATCH_SIZE=100
MERKLE_BATCH_ANCHOR_INTERVAL_SECONDS=300

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ---- Actuator ----
ACTUATOR_USERNAME=actuator_admin
ACTUATOR_PASSWORD=<strong-actuator-password>
